# Dependencies and build caches
node_modules/
.vite/

# Test output (screenshots, CSV exports, settings backups from local runs)
tests/e2e/out/

# Local environment and secrets: never commit
.env
.env.*
wp-config.php
*.sql
*.sql.gz
*.log
.DS_Store
!app/migrations/*.sql

# ViralNest 2.0 local config, runtime data and build output
app/config.php
/dist/
app/storage/cv/**
app/storage/logs/**
app/storage/sessions/**
app/storage/cache/**
!app/storage/*/.gitkeep
public/uploads/*
!public/uploads/.htaccess
!public/uploads/.gitkeep
